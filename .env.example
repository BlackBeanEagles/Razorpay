# Copy this file to .env and fill in real values. Never commit the real .env file.

# Razorpay TEST-MODE credentials only (Dashboard -> Settings -> API Keys -> Test Mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# LLM provider for the agent (tool-calling). Get a free key at https://console.groq.com/keys
# Without this set, the agent falls back to the deterministic regex router (agent/agent.py).
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-120b

# Secret used to sign/verify Guardrail's mandate tokens (HMAC). Generate any long random string.
MANDATE_SIGNING_SECRET=replace-with-a-long-random-string

# Merchant/audit dashboard admin login (see api/auth.py). Change these before any real demo.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme-admin-password
SESSION_SIGNING_SECRET=replace-with-a-long-random-string

# Resend (https://resend.com) -- sends the "your issue has been received"/"resolved" support
# emails (audit/mailer.py). Free tier, single API key, no SMTP setup. Without a verified domain
# in your Resend account, delivery only succeeds to the email address your account is
# registered with -- see audit/mailer.py's docstring.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Razorpay webhook signature verification (api/routes/webhooks.py, POST /api/webhooks/razorpay).
# Set this to the "Secret" shown when you add a webhook in Dashboard -> Settings -> Webhooks
# (subscribe to payment.captured). Without it, the webhook endpoint refuses every request rather
# than trusting an unverified payload -- see that file's docstring for why. Testing locally needs
# a public HTTPS URL pointed at this server (ngrok, Razorpay's CLI webhook forwarding, or a real
# deployment) -- Razorpay cannot reach localhost directly.
RAZORPAY_WEBHOOK_SECRET=replace-with-the-secret-shown-in-your-dashboard
